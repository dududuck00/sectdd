{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecTDD external benchmark inventory manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "manifest_type",
    "benchmark",
    "repository",
    "generator",
    "status",
    "summary",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_type": {
      "const": "external_benchmark_inventory"
    },
    "benchmark": {
      "type": "object",
      "required": [
        "name",
        "version_label",
        "evaluation_scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_label": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "path",
        "remote_url",
        "commit",
        "commit_date",
        "dirty"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "remote_url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_date": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "const": false
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "path",
        "policy_version",
        "deterministic"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "deterministic": {
          "const": true
        }
      }
    },
    "status": {
      "const": "inventory_only"
    },
    "summary": {
      "type": "object",
      "required": [
        "task_count",
        "cwe_count",
        "language_counts",
        "candidate_for_oracle_audit_count",
        "issue_counts"
      ],
      "properties": {
        "task_count": {
          "type": "integer",
          "minimum": 1
        },
        "cwe_count": {
          "type": "integer",
          "minimum": 1
        },
        "language_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "candidate_for_oracle_audit_count": {
          "type": "integer",
          "minimum": 0
        },
        "issue_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "task_id",
          "cwe",
          "language",
          "source",
          "tests",
          "dependencies",
          "eligibility"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CWE-[0-9]+$"
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object"
          },
          "tests": {
            "type": "object"
          },
          "dependencies": {
            "type": "object"
          },
          "eligibility": {
            "type": "object",
            "required": [
              "inventory_complete",
              "candidate_for_oracle_audit",
              "issues"
            ],
            "properties": {
              "inventory_complete": {
                "type": "boolean"
              },
              "candidate_for_oracle_audit": {
                "type": "boolean"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
