{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecTDD paper-candidate oracle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "oracle_set_id",
    "status",
    "benchmark",
    "language",
    "design",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "oracle_set_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["draft", "paper_candidate", "reviewed", "frozen"]
    },
    "benchmark": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "language": {"type": "string", "minLength": 1},
    "design": {
      "type": "object",
      "required": ["split_unit", "hidden_access", "warning"],
      "properties": {
        "split_unit": {"const": "behavior_family"},
        "hidden_access": {"const": "final_evaluation_only"},
        "warning": {"type": "string", "minLength": 1}
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "cwe",
          "callable",
          "contract",
          "oracles",
          "cases",
          "subjects"
        ],
        "properties": {
          "cwe": {"type": "string", "minLength": 1},
          "callable": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "oracles": {
            "type": "object",
            "required": ["visible", "hidden"],
            "properties": {
              "visible": {"type": "string", "minLength": 1},
              "hidden": {"type": "string", "minLength": 1}
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "case_id",
                "partition",
                "marker",
                "behavior_family",
                "test_name",
                "description"
              ],
              "properties": {
                "case_id": {"type": "string", "minLength": 1},
                "partition": {"enum": ["visible", "hidden"]},
                "marker": {"enum": ["functionality", "security"]},
                "behavior_family": {"type": "string", "minLength": 1},
                "test_name": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1}
              }
            }
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "subject_id",
                "kind",
                "source",
                "expected_visible",
                "expected_hidden"
              ],
              "properties": {
                "subject_id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["reference", "mutant"]},
                "source": {"type": "string", "minLength": 1},
                "expected_visible": {"type": "boolean"},
                "expected_hidden": {"type": "boolean"},
                "fault_model": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
