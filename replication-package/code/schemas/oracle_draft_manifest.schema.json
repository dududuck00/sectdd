{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecTDD experimental behavior-family oracle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "oracle_id",
    "status",
    "benchmark",
    "tasks",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "oracle_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "frozen"]},
    "benchmark": {"type": "string", "minLength": 1},
    "protocol": {"type": "string"},
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "approved", "changes_requested"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]}
      }
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "cwe",
          "source_task",
          "contract",
          "threat_model",
          "cases"
        ],
        "properties": {
          "cwe": {"type": "string"},
          "source_task": {"type": "string"},
          "contract": {"type": "string"},
          "threat_model": {"type": "string"},
          "known_reference_limitations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "case_id",
                "partition",
                "marker",
                "behavior_family",
                "test_file",
                "pytest_nodeid",
                "rationale",
                "oracle_basis",
                "target_mutants"
              ],
              "properties": {
                "case_id": {"type": "string", "minLength": 1},
                "partition": {"enum": ["visible", "hidden"]},
                "marker": {"enum": ["functionality", "security"]},
                "behavior_family": {"type": "string", "minLength": 1},
                "test_file": {"type": "string", "minLength": 1},
                "pytest_nodeid": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1},
                "oracle_basis": {
                  "enum": [
                    "contract",
                    "threat_model",
                    "reference_differential"
                  ]
                },
                "source_case_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "target_mutants": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "task",
          "kind",
          "source",
          "expected"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "kind": {"enum": ["reference", "mutant"]},
          "source": {"type": "string", "minLength": 1},
          "mutation": {"type": ["string", "null"]},
          "expected": {
            "type": "object",
            "required": ["visible", "hidden"],
            "properties": {
              "visible": {"enum": ["pass", "fail", "either"]},
              "hidden": {"enum": ["pass", "fail", "either"]}
            }
          }
        }
      }
    }
  }
}
